{
    "name": "oolong-feedback-bot",
    "main": "src/index.js",
    "compatibility_date": "2026-10-01",
    "d1_databases": [
        { "binding": "DB", "database_name": "oolong-feedback", "database_id": "ad6eadc8-ed64-46f4-ba9a-83d542524649" }
    ],
    "ai": { "binding": "AI" },
    // Every ten minutes, new feedback is written up and messages older than a few days dropped;
    // GROUP_ID, OWNER_ID and BOT_TOKEN, which fetches screenshots, are secrets
    "triggers": { "crons": ["*/10 * * * *"] }
}
